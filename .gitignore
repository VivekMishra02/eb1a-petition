# Ignore everything by default
*

# Allow directory traversal (required for git to find whitelisted files in subdirectories)
!*/

# Keep repository configuration and standard documentation
!.gitignore
!.gitattributes
!README.md

# Keep the main petition LaTeX document and the generated main.pdf
!main.tex
!main.pdf

# Keep cover page LaTeX files
!cover/
!cover/**

# Keep only the final recommendation letters (excluding drafts/Word docs)
!LOR/
!LOR/FinalLetters/
!LOR/FinalLetters/**

# Keep the entire criteria folder (including all criteria descriptions and evidence files)
!criteria/
!criteria/**

# ==========================================
# LaTeX build/intermediate files to ignore
# (applies globally across all allowed directories)
# ==========================================
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.bak
*.bak_*
*.backup
*.backup_*
*~
missfont.log

# ==========================================
# OS and IDE configuration files to ignore
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
